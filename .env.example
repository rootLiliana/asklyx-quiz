VITE_API_URL=https://asklyx-quiz.onrender.com

DB_HOST=tu_host_tidb
DB_PORT=4000
DB_USER=tu_usuario_tidb
DB_PASSWORD=tu_password_tidb
DB_NAME=quiz
DB_SSL=true

# URL pública del frontend: se usa para armar el enlace de "¿Olvidaste tu contraseña?"
APP_URL=https://asklyx-quiz-sandy.vercel.app

# Correo saliente (recuperación de contraseña). Sin SMTP_HOST, el enlace solo se imprime en la consola del servidor.
# Ejemplo con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465 y una "contraseña de aplicación" en SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Lilihoot <no-reply@tu-dominio.com>"
